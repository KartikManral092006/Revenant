{
  "name": "revenant",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build:node": "tsc -p tsconfig.node.json",
    "build": "npm run build:node && node build/node/lib/graveyard/check-pins.js && npm ci --ignore-scripts --prefix graveyard && next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "autopsy:snapshots": "npm run build:node && node --env-file-if-exists=.env.local build/node/scripts/write-autopsy-snapshots.js",
    "reverse-spec:bundles": "npm run build:node && node --env-file-if-exists=.env.local build/node/scripts/write-reverse-spec-bundles.js",
    "record:ghost-memory": "npm run build:node && node build/node/scripts/record-ghost-memory.js",
    "resurrect": "node build/node/lib/diff/cli.js",
    "test": "vitest --run"
  },
  "dependencies": {
    "groq-sdk": "^1.6.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "autoprefixer": "^10.6.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "fast-check": "^4.10.2",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.19",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.1.0"
  }
}
